# Copy this file to .env.local and fill in the values.
# Supabase dashboard → Project Settings → API (or "API Keys")

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" / "publishable" key — safe in the browser (tables are locked down with RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret "service_role" / "secret" key — server only. Never commit or share it.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign login cookies (e.g. run: openssl rand -base64 32)
SESSION_SECRET=
